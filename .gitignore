# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
.venv-wsl/

# Runtime data — not needed for the app's function, regenerated/populated
# on use (component folders, cascade embeddings' side files, knowledge-base
# index, logs, downloaded YOLO weights). See scripts/sync_to_wsl.ps1, which
# already excludes this same folder when mirroring to WSL.
data/

# Local SQLite database and backups — user/runtime data, not source.
emil.db
emil.db.bak-*

# Generated evaluation/training artifacts (plots, reports) — regenerated by
# training/evaluation runs, not needed to run the app itself.
results/

# Streamlit / editor / OS cruft
.streamlit/secrets.toml
.DS_Store
Thumbs.db

# Claude Code local settings (machine-specific permissions, not shared config)
.claude/settings.local.json
